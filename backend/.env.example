# Application
APP_NAME=Ventrix
APP_VERSION=0.1.0
DEBUG=True
SECRET_KEY=dev-secret-change-in-production

# LLM API Keys (backend only - never expose to frontend)
GEMINI_API_KEY=your-gemini-api-key-here
NVIDIA_API_KEY=your-nvidia-api-key-here
MISTRAL_API_KEY=your-mistral-api-key-here

# Supabase (backend only - never expose service role key to frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
# Supabase Postgres connection string (SQLAlchemy format)
# Example: postgresql+psycopg2://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
SUPABASE_DATABASE_URL=

# Database fallback (used when SUPABASE_DATABASE_URL is empty)
DATABASE_URL=sqlite:///./ventrix.db

# Due diligence workflow
WORKFLOW_MAX_RETRIES=2
WORKFLOW_RETRY_BACKOFF_SECONDS=0.05
WORKFLOW_MAX_PAGES=5

# Analysis usage limit
MAX_ANALYSES=10

# CORS (frontend origin)
CORS_ORIGINS=http://localhost:3000
